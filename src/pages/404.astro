---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon';
import { getSettings } from '../lib/server/db';

const settings = await getSettings();
Astro.response.status = 404;
---

<Base settings={settings} title="Página no encontrada" noindex>
  <div class="section container">
    <div class="empty">
      <span class="empty__icon"><Icon name="search" size={36} /></span>
      <h1>No encontramos esta página</h1>
      <p>Es posible que el enlace esté incompleto o que la página ya no exista.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/catalogo">Ver el catálogo</a>
        <a class="btn btn--ghost" href="/">Ir al inicio</a>
      </div>
    </div>
  </div>
</Base>
