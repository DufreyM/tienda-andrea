---
import '../styles/global.css';
import '../styles/detail.css';
import '../styles/admin.css';
import AdminApp, { type AdminPage } from '../components/admin/AdminApp';

interface Props {
  page: AdminPage;
  title: string;
}
const { page, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Administración</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <AdminApp client:only="preact" page={page}>
      <div class="admin-center" slot="fallback" role="status">
        <span class="spinner" aria-hidden="true"></span> Cargando…
      </div>
    </AdminApp>
    <noscript>
      <div class="admin-center"><p>El área de administración necesita JavaScript activado.</p></div>
    </noscript>
  </body>
</html>
