# Copia este archivo como .env y completa los valores. No subas .env al repositorio.

# URL del proyecto de Supabase (Project Settings > API > Project URL).
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA (publishable / anon). Es segura en el navegador porque los permisos
# los controla Row Level Security. Nunca pongas aquí la clave service_role / secret.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Solo para los scripts locales de respaldo y restauración (npm run respaldo) ---
# Credenciales del administrador. Úsalas solo en tu computadora.
ADMIN_EMAIL=
ADMIN_PASSWORD=
